# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DATABASE_NAME=nexusSocial

# AI Configuration (Local Ollama API)
# Make sure Ollama is running with: ollama serve
# And phi3 model is installed with: ollama pull phi3
USE_LOCAL_ONLY=false
AI_API_URL=http://localhost:11434/api/chat
AI_MODEL=phi3

# Polling Configuration
POLL_INTERVAL_SECONDS=60
LOOKBACK_SECONDS=60

# Chatbot Configuration  
RESPONSE_RATE=0.3

# The chat responder uses predefined bot users from the config
# No need to configure usernames/avatars - they're built into the app

# Free AI alternatives you can try (most still require signup):
# AI_API_URL=https://puter.com/api/chat (No key required)
# AI_API_URL=https://api.cohere.ai/v1/generate (Free tier)
# AI_API_URL=https://api-inference.huggingface.co/models/microsoft/DialoGPT-medium (Rate limited)